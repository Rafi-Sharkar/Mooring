{
  "name": "@dockhand/database",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "db:generate": "pnpm exec prisma generate",
    "db:push": "pnpm exec prisma db push",
    "db:migrate": "pnpm exec prisma migrate dev",
    "db:studio": "pnpm exec prisma studio",
    "db:seed": "pnpm exec ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "argon2": "^0.41.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.7.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  }
}
