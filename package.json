{
  "name": "dockhand",
  "version": "1.0.0",
  "private": true,
  "description": "Dockhand — Centralized Docker fleet monitoring system",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @dockhand/database db:generate",
    "db:push": "pnpm --filter @dockhand/database db:push",
    "db:migrate": "pnpm --filter @dockhand/database db:migrate",
    "db:studio": "pnpm --filter @dockhand/database db:studio"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
